<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\OmniVoice.Core\OmniVoice.Core.csproj" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>

    <AssemblyName>OmniSpeak</AssemblyName>
    <RootNamespace>OmniVoice.App</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="NAudio" Version="2.2.1" />
  </ItemGroup>

  <!-- Packaged builds: scripts/package-windows.ps1 freezes the Python engine to
       dist/engine/omnispeak-engine.exe first; publishing with PublishSingleFile +
       IncludeAllContentForSelfExtract then embeds it inside OmniSpeak.exe and
       extracts it next to the app at first run, where EngineLauncherLocator
       prefers it over the dev launcher scripts. Dev builds simply skip this. -->
  <ItemGroup Condition="Exists('$(MSBuildProjectDirectory)\..\..\dist\engine\omnispeak-engine.exe')">
    <Content Include="$(MSBuildProjectDirectory)\..\..\dist\engine\omnispeak-engine.exe"
             Link="omnispeak-engine.exe"
             CopyToOutputDirectory="PreserveNewest"
             CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
